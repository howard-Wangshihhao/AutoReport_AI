# ==========================================
# 1. Office 暫存檔與暫存鎖定檔 (極度重要)
# ==========================================
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc

# ==========================================
# 2. 自動化產出的結果資料夾 (保留結構但忽略內容)
# ==========================================
output/*
!output/.gitkeep

# ==========================================
# 3. Python 相關快取與環境
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# 虛擬環境
.venv/
venv/
ENV/
env/
backup/

# Jupyter Notebook 暫存
.ipynb_checkpoints/

# ==========================================
# 4. 敏感與環境變數設定檔 (若有用到)
# ==========================================
.env
config.local.py

# ==========================================
# 5. 作業系統系統檔
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSSharedFileList

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code / IDE 設定
.vscode/
.idea/